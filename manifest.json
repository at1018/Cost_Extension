{
  "manifest_version": 3,
  "name": "CostGuard - Infrastructure Cost Guard",
  "version": "1.0.0",
  "description": "Real-time cloud infrastructure cost monitoring. Track AWS EC2, RDS, and GCP Compute Engine spending in real-time without server overhead.",
  "permissions": [
    "storage",
    "notifications",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "https://*.console.aws.amazon.com/*",
    "https://*.console.cloud.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.console.aws.amazon.com/*",
        "https://*.console.cloud.google.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "CostGuard - Real-time Cost Tracker",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "48": "icons/icon-48.svg",
      "128": "icons/icon-128.svg"
    }
  },
  "icons": {
    "16": "icons/icon-16.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  }
}
